# Copy this file to .env and adjust as needed.

TRAVEAI_ENV=development
TRAVEAI_DEBUG=true
TRAVEAI_DATABASE_URL=sqlite:///./traveai.db

# Test API keys for local development only (format: key:merchant_id, comma-separated).
# `python -m traveai.seed` stores these (hashed) in the database for the demo merchants.
TRAVEAI_SEED_API_KEYS=sk_test_pharmacy_4f8a2c91e7b3:merch_demo_pharmacy,sk_test_restaurant_9d1e6b03a5c7:merch_demo_restaurant

# Flight simulator (runs inside the API server)
TRAVEAI_SIM_ENABLED=true
TRAVEAI_SIM_SPEED=10
TRAVEAI_SIM_FAILURE_RATE=0.05

# Webhook sender (runs inside the API server)
TRAVEAI_WEBHOOKS_ENABLED=true
TRAVEAI_ALLOW_NIGHT_OPERATIONS=false
# Lets test keys change the simulator speed at runtime (sandbox servers only)
TRAVEAI_SANDBOX_CONTROLS=true

# --- Production (see README "Production deployment") ---
# TRAVEAI_ENV=production
# TRAVEAI_DATABASE_URL=postgresql+psycopg://traveai:password@localhost:5432/traveai
# TRAVEAI_SECRET_KEY=   # python -m traveai.crypto new-key
# TRAVEAI_REDIS_URL=redis://localhost:6379/0
# TRAVEAI_RATE_LIMIT_PER_MINUTE=600
